theme = dark:GruvboxDark,light:GruvboxLight
#font-family = "PragmataPro VF Mono Liga"
#font-family = "PragmataPro VF Mono Regular"
#font-family = "Rec Mono Semicasual"
font-family = "Rec Mono Duotone"
#font-variation = "wght=497"
font-feature = "-calt"
font-size = 13

freetype-load-flags=no-hinting
app-notifications = no-clipboard-copy
background-opacity = 0.8
background-blur = true

cursor-style = underline
cursor-style-blink = true
mouse-hide-while-typing=true


unfocused-split-opacity = 0.50
mouse-hide-while-typing = true

keybind = ctrl+x>2=new_split:right
keybind = ctrl+x>3=new_split:up
keybind = ctrl+x>h=goto_split:left
keybind = ctrl+x>g=goto_split:right
keybind = ctrl+x>k=goto_split:top
keybind = ctrl+x>j=goto_split:bottom
