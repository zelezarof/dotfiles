#compdef Rustique

autoload -U is-at-least

_Rustique() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-m+[Specify the directory to manage mods. This takes priority over any other directory setting, including from the config file]:MODS_DIR:_default' \
'--mods-dir=[Specify the directory to manage mods. This takes priority over any other directory setting, including from the config file]:MODS_DIR:_default' \
'-w+[This command will set the working mod directory to be that of the modpack specified, INCLUDING modpacks you create. If you use this to work on a custom modpack, you will need to run Rustique modpack create again to update your modpack file, just set the --mpk-id to the same one you used before to overwrite the old one]:WITH_MPK:_default' \
'--with-mpk=[This command will set the working mod directory to be that of the modpack specified, INCLUDING modpacks you create. If you use this to work on a custom modpack, you will need to run Rustique modpack create again to update your modpack file, just set the --mpk-id to the same one you used before to overwrite the old one]:WITH_MPK:_default' \
'-v[Shows info level logging messages. This is very noisy, used for debugging]' \
'--verbose[Shows info level logging messages. This is very noisy, used for debugging]' \
'-d[Shows all logging messages. This is EXTREMELY noisy. Only run this if you have to]' \
'--debug[Shows all logging messages. This is EXTREMELY noisy. Only run this if you have to]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_Rustique_commands" \
"*::: :->Rustique" \
&& ret=0
    case $state in
    (Rustique)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:Rustique-command-$line[1]:"
        case $line[1] in
            (sync)
_arguments "${_arguments_options[@]}" : \
'-s[Sync the mod info from the api endpoint /api/mods and save it locally]' \
'--sync-search-db[Sync the mod info from the api endpoint /api/mods and save it locally]' \
'-g[Sync a local list of all game versions from the api. This is used with version pinning to ensure we have accurate version numbers]' \
'--sync-game-versions[Sync a local list of all game versions from the api. This is used with version pinning to ensure we have accurate version numbers]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-g+[(Does not work with modpack commands) List all game versions for MAJOR.MINOR\: Example, Rustique list --game-versions 1.20, which will show all valid versions for 1.20.x, --game-versions 1 will show all versions 1.x.x]:MAJOR.MINOR:_default' \
'--game-versions=[(Does not work with modpack commands) List all game versions for MAJOR.MINOR\: Example, Rustique list --game-versions 1.20, which will show all valid versions for 1.20.x, --game-versions 1 will show all versions 1.x.x]:MAJOR.MINOR:_default' \
'-e+[Instead of printing the text table, export to this type instead. IF you use csv AND show the changelog column, you may not be able to redirect to a file as long text can get truncated. Use -f /path/to/save.csv instead]:EXPORT_AS:(csv)' \
'--export-as=[Instead of printing the text table, export to this type instead. IF you use csv AND show the changelog column, you may not be able to redirect to a file as long text can get truncated. Use -f /path/to/save.csv instead]:EXPORT_AS:(csv)' \
'*-c+[Show specific columns for the list output. This flag takes priority over the config values for the list display]:COLUMNS:(name mod-id version latest-version deps missing-deps changelog description website game-version last-update-local last-update-remote pinned-version has-backup filename mod-url)' \
'*--columns=[Show specific columns for the list output. This flag takes priority over the config values for the list display]:COLUMNS:(name mod-id version latest-version deps missing-deps changelog description website game-version last-update-local last-update-remote pinned-version has-backup filename mod-url)' \
'-f+[Set this to save output to file INSTEAD of stdout, used with --export-as]:PATH:_files' \
'--file-path=[Set this to save output to file INSTEAD of stdout, used with --export-as]:PATH:_files' \
'-u[List only mods that need updating]' \
'--updates[List only mods that need updating]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'-a[Update all mods, don'\''t set a <name>. Example\: ./Rustique update --all]' \
'--all[Update all mods, don'\''t set a <name>. Example\: ./Rustique update --all]' \
'-k[Update mods but keep old version]' \
'--keep-old-files[Update mods but keep old version]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
