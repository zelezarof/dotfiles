(search)
_arguments "${_arguments_options[@]}" : \
'-q+[This text query will search all available text fields, author, summary, name, urlalias, tags, side, type]:QUERY:_default' \
'--query=[This text query will search all available text fields, author, summary, name, urlalias, tags, side, type]:QUERY:_default' \
