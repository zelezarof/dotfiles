#!/bin/zsh
################################################################################
#                                     Term                                     #
################################################################################
export TERMINAL="ghostty"


################################################################################
#                                     ZSH                                      #
################################################################################
HISTFILE=~/.zshistory
HISTSIZE=10240
SAVEHIST=10240


################################################################################
#                                    Editor                                    #
################################################################################
export EDITOR="nvim"
export VISUAL="nvim"


################################################################################
#                                     XDG                                      #
################################################################################
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"
export XDG_BIN_HOME="${HOME}/.local/bin"


################################################################################
#                                  Bin Folder                                  #
################################################################################
if [[ -e ${XDG_BIN_HOME} && ! ${PATH} =~ ${XDG_BIN_HOME} ]]; then
        export PATH="${XDG_BIN_HOME}:$PATH"
fi


################################################################################
#                                    GoEnv                                     #
################################################################################
export GOPATH=/home/zelezarof/.local/lib/go
if [[ -e ${GOPATH} ]]; then
    export PATH="${GOPATH}/bin:${PATH}"
fi


################################################################################
#                                  DoomEmacs                                   #
################################################################################
if [[ -e ${XDG_CONFIG_HOME}/emacs/bin ]]; then
    export PATH="${XDG_CONFIG_HOME}/emacs/bin:${PATH}"
fi


################################################################################
#                                    PyEnv                                     #
################################################################################
if [[ -e "${HOME}/.pyenv" ]]; then
    export PYENV_ROOT="${HOME}/.pyenv"
fi


################################################################################
#                                   DotNet                                     #
################################################################################
export DOTNET_INSTALL_DIR="${XDG_DATA_HOME}/dotnet"
if [[ -e ${DOTNET_INSTALL_DIR} && ! ${PATH} =~ ${DOTNET_INSTALL_DIR} ]]; then
    export DOTNET_ROOT=${DOTNET_INSTALL_DIR}
    export PATH="${PATH}:${DOTNET_ROOT}:${DOTNET_ROOT}/tools"
fi


################################################################################
#                                 1Password                                    #
################################################################################
if [[ -e "${HOME}/.1password/agent.sock" ]]; then
    export SSH_AUTH_SOCK="${HOME}/.1password/agent.sock"
fi
